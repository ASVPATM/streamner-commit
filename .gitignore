data/test_sentences.jsonl

# Large/raw experiment output
results/raw/*
!results/raw/.gitkeep
results/traces/
results/analysis/.sweep_checkpoints/
# Local experiments, recovery scripts, learning notes, and logs stay private.
# Already tracked smoke summaries remain tracked; reviewed public summaries use results/pilot/.
results/analysis/
.private/
*.log
*.tar
*.tar.gz
*.tgz
*.zip
*.bundle

